# FENIX Trading Bot - Variables de Entorno
# Copia este archivo como .env y completa con tus credenciales reales

# ===== BINANCE API =====
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ===== CONFIGURACIÓN DE ENTORNO =====
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== CONFIGURACIÓN DE TRADING =====
TRADING_MODE=testnet
DEFAULT_SYMBOL=BTCUSDT
MAX_POSITION_SIZE=100

# ===== CONFIGURACIÓN DE RIESGO =====
MAX_DAILY_LOSS=500
STOP_LOSS_PERCENTAGE=2.0
TAKE_PROFIT_PERCENTAGE=4.0

# ===== CONFIGURACIÓN LLM =====
# Opcional: Si usas servicios externos de LLM
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_PROFILE=groq_free
LLM_ALLOW_NOOP_STUB=1  # Set 0 in production to fail fast when LLM providers are missing

# ===== HUGGINGFACE API (RECOMENDADO para paralelización) =====
# Obtener token gratis en: https://huggingface.co/settings/tokens
# Tier gratuito: ~30 requests/min (suficiente para trading)
HUGGINGFACE_API_KEY=hf_your_token_here
# Alternativa: HF_TOKEN=hf_your_token_here

# ===== CONFIGURACIÓN HÍBRIDA (MLX Local + APIs Cloud) =====
# Forzar agentes específicos a usar API (opcional)
# Útil para paralelización sin consumir RAM local
FORCE_API_SENTIMENT=false
FORCE_API_VISUAL=false
FORCE_API_QABBA=false

# Fallback automático si API falla → MLX local
ENABLE_API_FALLBACK=true

# Ollama Cloud (alternativa a HuggingFace)
# OLLAMA_CLOUD_API_KEY=your_ollama_key_here
# OLLAMA_CLOUD_URL=https://ollama.ai/api

# ===== CONFIGURACIÓN DE MONITOREO =====
# Opcional: Para alertas y notificaciones
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ===== CONFIGURACIÓN DE BASE DE DATOS =====
# SQLite para desarrollo local (default):
DATABASE_URL=sqlite+aiosqlite:///fenix_trading.db
# Para varios procesos locales (CLI + API), SQLite usa WAL y espera ante locks.
FENIX_SQLITE_BUSY_TIMEOUT_MS=30000
#
# PostgreSQL para producción multi-proceso (recomendado para >2 instancias):
# DATABASE_URL=postgresql+asyncpg://fenix:password@localhost:5432/fenix_trading
# FENIX_PG_POOL_SIZE=10
# FENIX_PG_MAX_OVERFLOW=5
# FENIX_PG_POOL_TIMEOUT_SEC=30
# FENIX_PG_STATEMENT_TIMEOUT_MS=30000

# ===== SEGURIDAD DE POSICIONES LIVE =====
# Reconciliar cada posición local con Binance, incluso si el SL/TP se llenó intravela.
FENIX_LIVE_POSITION_RECONCILIATION_ENABLED=true
FENIX_LIVE_POSITION_RECONCILIATION_INTERVAL_SEC=5
FENIX_USER_DATA_STREAM_ENABLED=true
FENIX_USER_DATA_CONNECT_TIMEOUT_SEC=15
FENIX_USER_DATA_RECONNECT_DELAY_SEC=2

# Live entries fail closed unless risk output and exchange-visible protection are valid.
FENIX_ENFORCE_LLM_RISK=true
FENIX_REQUIRE_LIVE_STOP_LOSS=true
FENIX_DETERMINISTIC_SIZING=true
FENIX_MAX_RISK_PER_TRADE=0.01
FENIX_MAX_EXPOSURE_PCT=0.05
FENIX_CAP_NOTIONAL_TO_AVAILABLE_MARGIN=true
FENIX_MAX_ENTRY_MARGIN_PCT=0.50
FENIX_ESTIMATED_ROUND_TRIP_FEE_PCT=0.0008

# Keep pyramiding disabled until combined-position accounting and protection
# have been validated on testnet for the exact deployment topology.
FENIX_PYRAMID_ENABLE=false
FENIX_ALLOW_ADD_TO_POSITION=false

# Cross-process account guard: serializes entry submissions and caps total
# initial margin across all Fenix symbols sharing the Binance account.
FENIX_GLOBAL_PORTFOLIO_GUARD=true
FENIX_MAX_ACCOUNT_MARGIN_PCT=0.50
FENIX_ACCOUNT_ORDER_LOCK_PATH=logs/runtime_locks/binance_account_order.lock

# Prevent duplicate Fenix processes for the same symbol.
FENIX_INSTANCE_LOCK_DIR=logs/runtime_locks

# Registro local por proceso: permite a la API identificar varios Fenix CLI.
# FENIX_INSTANCE_ID=ethusdc-15m
# FENIX_OPERATIONAL_STATE_DIR=logs
FENIX_INSTANCE_FRESHNESS_SEC=20

# ===== ALERTAS EXTERNAS DE SAFETY =====
# Alertas para eventos críticos: ORDER_OUTCOME_UNCERTAIN, ACCOUNT_MARGIN_CAP,
# PROTECTION_NOT_VERIFIED, RECONCILIATION_FAILURE, STALE_HEARTBEAT.
# Reutilizan las mismas credenciales de Telegram/Discord del circuit breaker.
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
FENIX_SAFETY_ALERT_MIN_SEVERITY=WARNING
FENIX_SAFETY_ALERT_COOLDOWN_SEC=300
FENIX_SAFETY_ALERT_MAX_PER_MIN=10

# ===== NANOFENIX RUNTIME =====
# El modelo pretrained es un seed de solo lectura; el aprendizaje live se guarda aparte.
# NANOFENIXV3_RUNTIME_MODEL_PATH=nanofenixv3/runtime_<symbol>_live_model.pkl

# Reddit RSS se degrada con backoff explícito tras un rate-limit HTTP 429.
FENIX_REDDIT_429_BACKOFF_SEC=900
FENIX_REDDIT_ERROR_BACKOFF_SEC=120

# ===== CONFIGURACIÓN DE CACHE =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change_this_redis_password
FENIX_REDIS_CHANNEL=fenix_socketio

# ===== CONFIGURACIÓN DE SEGURIDAD =====
SECRET_KEY=your_secret_key_for_encryption_here
JWT_SECRET=your_jwt_secret_here
FENIX_API_PORT=8001
PYTHON_VERSION=3.12.13

# ===== CONFIGURACIÓN DE DESARROLLO =====
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true

# ===== CONFIGURACIÓN DE PERFORMANCE =====
MAX_WORKERS=4
CACHE_TTL=300
BATCH_SIZE=100

# ===== CONFIGURACIÓN DE TIMEFRAMES =====
PRIMARY_TIMEFRAME=1m
SECONDARY_TIMEFRAME=5m
ANALYSIS_TIMEFRAME=15m

# ===== CONFIGURACIÓN DE AGENTES =====
ENABLE_SENTIMENT_AGENT=true
ENABLE_TECHNICAL_AGENT=true
ENABLE_VISUAL_AGENT=true
ENABLE_QABBA_AGENT=true
ENABLE_RISK_AGENT=true

# ===== CONFIGURACIÓN DE ALERTAS =====
ENABLE_EMAIL_ALERTS=false
ENABLE_SMS_ALERTS=false
ENABLE_PUSH_NOTIFICATIONS=false

# ===== CONFIGURACIÓN DE BACKUP =====
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP=true
